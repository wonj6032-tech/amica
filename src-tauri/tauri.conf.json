{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amica AI",
  "version": "1.0.0",
  "identifier": "com.wonj6032.amica",
  "build": {
    "beforeBuildCommand": "npm run build && npm run splash",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:3000",
    "distDir": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Amica AI",
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "transparent": false 
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "targetSdkVersion": 34, 
      "applicationId": "com.wonj6032.amica",
      "vulkan": true
    }
  },
  "plugins": {
    "shell": { "allow": [{ "name": "open", "program": "xdg-open", "args": [".*"] }] },
    "http": { "scope": ["http://localhost:11434/*", "https://*.openai.com/*"] },
    "fs": { "scope": ["$RESOURCE/*", "$APPDATA/*", "$CACHE/*"] }
  }
}
